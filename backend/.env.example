# ==========================================
# JarvisOS Environment Template (.env.example)
# Copy this file to .env and fill in your values
# ==========================================

# Optional: Google Gemini API Key from Google AI Studio
# If not provided, JarvisOS will operate using its built-in Native Intelligence & Heuristic Planner with 100% functionality.
GEMINI_API_KEY=

# Server Port
PORT=3001

# MongoDB Connection String
# Examples:
# Local: mongodb://localhost:27017/jarvis-os
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/jarvis-os
MONGODB_URI=mongodb://localhost:27017/jarvis-os
