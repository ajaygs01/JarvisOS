# ==========================================
# JarvisOS Environment Configuration
# ==========================================

# Google Gemini API Key (from https://aistudio.google.com/)
# Optional: If omitted, JarvisOS uses its built-in Native Heuristic Planner with 100% functionality.
GEMINI_API_KEY=

# Server Port (default: 3001)
PORT=3001

# MongoDB Connection String
# Optional: If MongoDB is unavailable or omitted, JarvisOS automatically falls back to local file storage.
MONGODB_URI=mongodb://localhost:27017/jarvis-os
